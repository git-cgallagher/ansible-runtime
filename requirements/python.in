# Direct Python dependencies of the image. Edit THIS file, then regenerate python.txt:
#   tests/lock.sh
# Ranges here are deliberately loose; python.txt pins every package (direct and transitive)
# to one exact version with hashes. Renovate bumps python.txt and keeps these ranges honest.
# Each line says why the package is here and who needs it.

# The controller. One exact version for every job (pinned in python.txt). The cross-version
# compatibility matrix (2.18 ... devel) stays in each collection's ansible-test sanity job.
ansible-core>=2.21,<2.22

# Linters: the `lint` job in every collection repo (yamllint . && ansible-lint).
ansible-lint
yamllint

# Molecule + the docker driver: every role scenario in isc and windows.
molecule
molecule-plugins[docker]
# Docker SDK: molecule-plugins' docker driver and community.docker's docker_api modules.
docker

# psrp connection: every Windows target (windows gpo_* roles, isc kea_dhcp_msdns, lab DCs).
pypsrp

# kubernetes.core modules: kea_dhcp and Stork in Kubernetes mode (isc).
kubernetes

# AWS SDK: git_cgallagher.aws (runtime target). Its ssm_parameter module and lookup run on the
# controller. The collection's requirements.txt sets the floor (boto3>=1.28.0, botocore>=1.31.0);
# this lock picks the one version every collection gets, and the build fails if it doesn't
# satisfy every installed collection's requirements.txt (tests/collection_requirements.py).
boto3
botocore

# Test tools that consumers' tests/unit + tests/integration requirements.txt declare. ansible-test
# installs those itself in its own containers (ranges); these pins are what the same tests get in
# this image, and what tests/collection_requirements.py checks the ranges against.
# moto (SSM + STS backends only) + flask/flask-cors for moto_server: git_cgallagher.aws units and
# integration. Not moto[server]: its cfn-lint chain sends pip backtracking (aws AGENTS.md).
moto[ssm,sts]
flask
flask-cors
# pytest: ansible-test units in every collection with unit tests (aws).
pytest
